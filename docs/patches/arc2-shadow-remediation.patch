+'use strict';
+// Independently authored ATLAS integration-audit regressions, synthetic only.
+// These validate local admission accounting, not source/time authenticity.
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const {auditPilot}=require('./pilot-admission.cjs');
+const meta=()=>({sport:'NBA',externalWitnessIndependentlyValidated:true,
+  originalProviderBytesAuthenticated:true,preregisteredCensusComplete:true,
+  frozenBaselineBeforeOutcomes:true,heldoutEventLevelDependenceAssessed:true,
+  minimumIndependentEvents:1});
+const row=changes=>({candidateId:'synthetic-candidate-1',eventId:'synthetic-event-1',
+  sport:'NBA',decision:'RESEARCH',eventStartsAt:'2026-11-01T19:00:00.000Z',
+  frozenAt:'2026-11-01T17:00:00.000Z',labelPublishedAt:'2026-11-02T01:00:00.000Z',
+  label:1,probability:0.55,baselineProbability:0.5,...changes});
+const flags=['externalWitnessIndependentlyValidated','originalProviderBytesAuthenticated',
+  'preregisteredCensusComplete','frozenBaselineBeforeOutcomes','heldoutEventLevelDependenceAssessed'];
+
+test('positive complete research cohort is mechanically consistent but cannot authorize publication',()=>{
+  const result=auditPilot([row()],meta());
+  assert.equal(result.mechanicalCoverageCheckPassed,true);
+  assert.equal(result.predictionCandidates,1);
+  assert.equal(result.completePredictionPairs,1);
+  assert.equal(result.missingModelPredictions,0);
+  assert.equal(result.missingBaselinePredictions,0);
+  assert.equal(result.scorePublicationPermitted,false);
+  assert.equal(result.externalIndependenceProvenByLocalModule,false);
+  assert.equal(result.finalGate,'HARD_BLOCK');
+});
+
+for(const flag of flags) test('assertion requires actual true: '+flag,()=>{
+  for(const claimed of ['false','true',1,0,{},[],null,undefined,false]){
+    const result=auditPilot([row()],{...meta(),[flag]:claimed});
+    assert.equal(result.mechanicalCoverageCheckPassed,false,'non-true assertion admitted');
+    assert.equal(result.scorePublicationPermitted,false);
+    assert.equal(result.finalGate,'HARD_BLOCK');
+  }
+});
+
+for(const decision of ['WATCH','PASS','ABSTAIN']){
+  test(decision+' never becomes a paired forecast by carrying probabilities',()=>{
+    for(const probabilities of [
+      {probability:0.55,baselineProbability:0.5},
+      {probability:0.55,baselineProbability:null},
+      {probability:null,baselineProbability:0.5}]){
+      const result=auditPilot([row({decision,...probabilities})],meta());
+      assert.equal(result.abstentions,1);
+      assert.equal(result.pairedForecastsScored,0);
+      assert.equal(result.predictionCandidates,0);
+      assert.equal(result.completePredictionPairs,0);
+      assert.equal(result.mechanicalCoverageCheckPassed,false);
+      assert(result.issueCodes.includes('ABSTENTION_HAS_PREDICTION'));
+    }
+  });
+  test(decision+' with explicit null predictions stays in candidate and label denominators',()=>{
+    const result=auditPilot([row(),row({candidateId:'synthetic-candidate-2',decision,
+      probability:null,baselineProbability:null})],meta());
+    assert.equal(result.candidateCount,2);
+    assert.equal(result.distinctEventCount,1);
+    assert.equal(result.labelsObserved,2);
+    assert.equal(result.abstentions,1);
+    assert.equal(result.predictionCandidates,1);
+    assert.equal(result.completePredictionPairs,1);
+    assert.equal(result.pairedForecastsScored,1);
+    assert.equal(result.mechanicalCoverageCheckPassed,true);
+    assert.equal(result.scorePublicationPermitted,false);
+  });
+}
+
+for(const decision of ['RESEARCH','SHORTLISTED']){
+  for(const missing of ['model','baseline','both']) test(decision+' cannot hide missing '+missing+' predictions behind another complete pair',()=>{
+    const incomplete=row({candidateId:'synthetic-candidate-2',eventId:'synthetic-event-2',decision,
+      probability:missing==='model'||missing==='both'?null:0.55,
+      baselineProbability:missing==='baseline'||missing==='both'?null:0.5});
+    const result=auditPilot([row(),incomplete],meta());
+    assert.equal(result.candidateCount,2);
+    assert.equal(result.distinctEventCount,2);
+    assert.equal(result.labelsObserved,2);
+    assert.equal(result.predictionCandidates,2);
+    assert.equal(result.completePredictionPairs,1);
+    assert.equal(result.pairedForecastsScored,1);
+    assert.equal(result.missingModelPredictions,missing==='baseline'?0:1);
+    assert.equal(result.missingBaselinePredictions,missing==='model'?0:1);
+    assert.equal(result.mechanicalCoverageCheckPassed,false);
+    assert(result.issueCodes.includes('INCOMPLETE_PREDICTION_COVERAGE'));
+  });
+}
+
+test('missing label retains complete prediction coverage but refuses admission',()=>{
+  const result=auditPilot([row(),row({candidateId:'synthetic-candidate-2',label:null,labelPublishedAt:null})],meta());
+  assert.equal(result.candidateCount,2);
+  assert.equal(result.predictionCandidates,2);
+  assert.equal(result.completePredictionPairs,2);
+  assert.equal(result.labelsObserved,1);
+  assert.equal(result.pairedForecastsScored,1);
+  assert.equal(result.mechanicalCoverageCheckPassed,false);
+  assert(result.issueCodes.includes('INCOMPLETE_LABEL_COVERAGE'));
+});
+
+test('abstention with unknown label remains visible and cannot rescue coverage',()=>{
+  const result=auditPilot([row(),row({candidateId:'synthetic-candidate-2',decision:'ABSTAIN',
+    probability:null,baselineProbability:null,label:null,labelPublishedAt:null})],meta());
+  assert.equal(result.candidateCount,2);
+  assert.equal(result.abstentions,1);
+  assert.equal(result.labelsObserved,1);
+  assert.equal(result.completePredictionPairs,1);
+  assert.equal(result.pairedForecastsScored,1);
+  assert.equal(result.mechanicalCoverageCheckPassed,false);
+});
+
+test('cohort and metadata are not mutated and result is deterministic',()=>{
+  const cohort=[row(),row({candidateId:'synthetic-candidate-2',decision:'PASS',probability:null,baselineProbability:null})];
+  const policy=meta(),before=JSON.stringify({cohort,policy});
+  assert.deepEqual(auditPilot(cohort,policy),auditPilot(cohort,policy));
+  assert.equal(JSON.stringify({cohort,policy}),before);
+});
+
+test('fully labeled abstained event cannot inflate paired forecast independence',()=>{
+  const result=auditPilot([row(),row({candidateId:'synthetic-candidate-2',eventId:'synthetic-event-2',
+    decision:'ABSTAIN',probability:null,baselineProbability:null})],{...meta(),minimumIndependentEvents:2});
+  assert.equal(result.mechanicalCoverageCheckPassed,false);
+  assert(result.issueCodes.includes('INSUFFICIENT_INDEPENDENT_EVENTS'));
+  assert.equal(result.distinctEventCount,2);
+  assert.equal(result.pairedForecastEventCount,1);
+  assert.equal(result.pairedForecastsScored,1);
+  assert.equal(result.abstentions,1);
+  assert.equal(result.labelsObserved,2);
+});
+
+test('two paired forecasts from distinct events satisfy the local count but never authorize release',()=>{
+  const result=auditPilot([row(),row({candidateId:'synthetic-candidate-2',eventId:'synthetic-event-2'})],
+    {...meta(),minimumIndependentEvents:2});
+  assert.equal(result.mechanicalCoverageCheckPassed,true);
+  assert.equal(result.distinctEventCount,2);
+  assert.equal(result.pairedForecastEventCount,2);
+  assert.equal(result.scorePublicationPermitted,false);
+  assert.equal(result.finalGate,'HARD_BLOCK');
+});
