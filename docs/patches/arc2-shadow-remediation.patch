+'use strict';
+// Independently authored audit regressions. Synthetic settlement only; no provider calls.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { base } = require('./fixture.cjs');
+const { analyzeShadow } = require('./outcome-intelligence.cjs');
+
+function fixture(ticket, mutate) {
+  const input = base();
+  input.worlds = [input.worlds[2]];
+  input.pairQueries = [];
+  input.tickets = [{ ticketId: 'audit-ticket', ...ticket }];
+  if (mutate) mutate(input.worlds[0].statsByEvent);
+  return input;
+}
+function review(input) {
+  const before = JSON.stringify(input);
+  const report = analyzeShadow(input);
+  assert.equal(JSON.stringify(input), before, 'audit must not modify supplied research');
+  assert.equal(report.gate.decision, 'HARD_BLOCK');
+  assert.equal(report.gate.approvalAuthority, false);
+  assert.equal(report.gate.placementAuthority, false);
+  assert.equal(report.gate.signoffReusable, false);
+  return report.preview[0];
+}
+const loseNFL = stats => { stats['NFL-202']['Fiction-C'].RECEPTIONS = 5; };
+const tickets = [
+  { kind: 'DOUBLE', legs: ['NBA_OVER20', 'NFL_REC6'], stakeCents: 100 },
+  { kind: 'TRIPLE', legs: ['NBA_OVER20', 'NFL_REC6', 'WNBA_3PM2'], stakeCents: 100 },
+  { kind: 'SGP', legs: ['NBA_OVER20', 'NBA_AST7'], stakeCents: 100, packageOddsMilli: 3800 },
+  { kind: 'SGPX', legs: ['NBA_OVER20', 'NBA_AST7', 'NFL_REC6'], stakeCents: 100, packageOddsMilli: 6300 },
+  { kind: 'ROUND_ROBIN', legs: ['NBA_OVER20', 'NFL_REC6', 'WNBA_3PM2'], rrSize: 2,
+    perComboStakeCents: 50, stakeCents: 150 },
+];
+
+for (const ticket of tickets) test(`${ticket.kind}: push plus loss cannot settle without a void policy`, () => {
+  const row = review(fixture(ticket, loseNFL));
+  assert.equal(row.legStates.NBA_OVER20, 'PUSH');
+  const result = row.ticketStates['audit-ticket'];
+  if (ticket.kind === 'ROUND_ROBIN') {
+    assert.equal(result.state, 'UNRESOLVED');
+    assert.equal(result.comboStates.UNRESOLVED_VOID_RULE, 2);
+    assert.equal(result.comboStates.LOSE, 1);
+  } else assert.equal(result.state, 'UNRESOLVED_VOID_RULE');
+  assert.equal(result.grossCents, null);
+  assert.equal(result.netCents, null);
+});
+
+test('explicit VOID_TICKET refunds push plus loss under its synthetic rule', () => {
+  assert.deepEqual(review(fixture({ ...tickets[0], voidPolicy: 'VOID_TICKET' }, loseNFL))
+    .ticketStates['audit-ticket'], { state: 'REFUND', grossCents: 100, netCents: 0 });
+});
+test('explicit DROP_LEG preserves the remaining loss under its synthetic rule', () => {
+  assert.deepEqual(review(fixture({ ...tickets[0], voidPolicy: 'DROP_LEG' }, loseNFL))
+    .ticketStates['audit-ticket'], { state: 'LOSE', grossCents: 0, netCents: -100 });
+});
+test('push plus win without policy remains unresolved', () => {
+  assert.deepEqual(review(fixture(tickets[0])).ticketStates['audit-ticket'],
+    { state: 'UNRESOLVED_VOID_RULE', grossCents: null, netCents: null });
+});
+test('no-push loss remains a loss without a void policy', () => {
+  assert.deepEqual(review(fixture({ ...tickets[0], legs: ['NBA_PTS20', 'NFL_REC6'] }, loseNFL))
+    .ticketStates['audit-ticket'], { state: 'LOSE', grossCents: 0, netCents: -100 });
+});
+test('single equality preserves PUSH leg classification and synthetic refund', () => {
+  const row = review(fixture({ kind: 'SINGLE', legs: ['NBA_OVER20'], stakeCents: 100 }));
+  assert.equal(row.legStates.NBA_OVER20, 'PUSH');
+  assert.deepEqual(row.ticketStates['audit-ticket'], { state: 'REFUND', grossCents: 100, netCents: 0 });
+});
+test('unknown stat remains unresolved even with explicit VOID_TICKET', () => {
+  const row = review(fixture({ ...tickets[0], voidPolicy: 'VOID_TICKET' }, stats => {
+    delete stats['NFL-202']['Fiction-C'].RECEPTIONS;
+  }));
+  assert.deepEqual(row.ticketStates['audit-ticket'], { state: 'UNRESOLVED', grossCents: null, netCents: null });
+});
