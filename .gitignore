# Ignore local OmniRoute runtime files, generated envs, logs, and dependencies.
.omniroute/
.omniroute-runtime/
.env
.env.*
!.env.omniroute.example
node_modules/
.npm/
.pnpm-store/
logs/
*.log

# Editor and system files
.DS_Store
.vscode/
*.swp

# Python helper bytecode is generated, not reviewable source.
__pycache__/
*.py[cod]
